#!/usr/bin/env python3
"""
(FAKE) stand-in for `edmFileUtil <url> --eventsInLumi`.

NGTLoopStep2.py only ever calls this with a single file URL and parses the
"run  lumisection  events" table it prints. Real files carry that info inside
CMSSW's ROOT metadata; our fake files instead carry it in their filename, using
the convention `run<RUN6DIGIT>_ls<LS>....root` (see scenario-player/seed.py's seed-run
and add-ls subcommands, which create files following it).

A file with a name that doesn't match the convention -- or that doesn't exist --
is reported as "ERR", the same signal NGTLoopStep2.py's GetListOfAvailableFiles
uses to skip files it can't read.
"""
import os
import re
import sys

PREFIX = "root://eoscms.cern.ch/"


def main():
    args = sys.argv[1:]
    url = args[0] if args else ""
    path = url[len(PREFIX):] if url.startswith(PREFIX) else url

    basename = os.path.basename(path)
    match = re.match(r"run(\d{6})_ls(\d+)", basename)

    if not match or not os.path.exists(path):
        print(f"ERR: (FAKE) edmFileUtil could not read {path}")
        return

    run_number = int(match.group(1))
    ls_number = int(match.group(2))
    events = 1000
    print(f"{run_number:>15}{ls_number:>13}{events:>13}")


if __name__ == "__main__":
    main()
